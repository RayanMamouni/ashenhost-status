datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

enum Role {
  admin
  member
  viewer
}

enum MonitorType {
  http
  ping
  tcp_port
  ssl_cert
  dns
}

enum MonitorStatus {
  up
  down
  degraded
  paused
}

enum IncidentStatus {
  investigating
  identified
  monitoring
  resolved
}

enum NotificationType {
  email
  slack
  webhook
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  plan                 String                @default("starter")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  memberships          Membership[]
  monitors             Monitor[]
  incidents            Incident[]
  statusPages          StatusPage[]
  notificationChannels NotificationChannel[]

  @@map("organizations")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String       @map("password_hash")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  memberships   Membership[]

  @@map("users")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  role           Role         @default(member)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model Monitor {
  id                   String        @id @default(cuid())
  organizationId       String        @map("organization_id")
  name                 String
  url                  String
  type                 MonitorType   @default(http)
  intervalSeconds      Int           @default(60) @map("interval_seconds")
  timeoutSeconds       Int           @default(10) @map("timeout_seconds")
  regions              String[]      @default(["eu-central"])
  expectedStatusCodes  Int[]         @default([200, 201, 204, 301, 302]) @map("expected_status_codes")
  status               MonitorStatus @default(up)
  lastCheckedAt        DateTime?     @map("last_checked_at")
  consecutiveFails     Int           @default(0) @map("consecutive_fails")
  consecutivePasses    Int           @default(0) @map("consecutive_passes")
  port                 Int?          // Per tcp_port
  dnsRecordType        String?       @default("A") @map("dns_record_type") // Per DNS check (A, AAAA, CNAME, TXT, MX)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checks               Check[]
  incidents            Incident[]

  @@index([organizationId])
  @@index([status])
  @@map("monitors")
}

model Check {
  id             String    @id @default(cuid())
  monitorId      String    @map("monitor_id")
  timestamp      DateTime  @default(now())
  responseTimeMs Int       @map("response_time_ms")
  statusCode     Int?      @map("status_code")
  success        Boolean
  errorMessage   String?   @map("error_message")
  region         String    @default("eu-central")

  monitor        Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@map("checks")
}

model Incident {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  monitorId      String?         @map("monitor_id")
  title          String
  status         IncidentStatus  @default(investigating)
  isManual       Boolean         @default(false) @map("is_manual")
  startedAt      DateTime        @default(now()) @map("started_at")
  resolvedAt     DateTime?       @map("resolved_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitor        Monitor?        @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  updates        IncidentUpdate[]

  @@index([organizationId])
  @@index([monitorId])
  @@index([status])
  @@map("incidents")
}

model IncidentUpdate {
  id         String         @id @default(cuid())
  incidentId String         @map("incident_id")
  message    String
  status     IncidentStatus
  createdAt  DateTime       @default(now()) @map("created_at")

  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt(sort: Desc)])
  @@map("incident_updates")
}

model StatusPage {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  slug           String       @unique
  description    String?
  customDomain   String?      @unique @map("custom_domain")
  monitorIds     String[]     @default([]) @map("monitor_ids")
  isPublic       Boolean      @default(true) @map("is_public")
  logoUrl        String?      @map("logo_url")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("status_pages")
}

model NotificationChannel {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  name           String           @default("Default Channel")
  type           NotificationType
  config         Json             // { email: string } or { webhookUrl: string } or { slackWebhookUrl: string }
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs           NotificationLog[]

  @@index([organizationId])
  @@map("notification_channels")
}

model NotificationLog {
  id          String              @id @default(cuid())
  channelId   String              @map("channel_id")
  event       String
  payload     Json
  success     Boolean
  error       String?
  sentAt      DateTime            @default(now()) @map("sent_at")

  channel     NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, sentAt(sort: Desc)])
  @@map("notification_logs")
}
