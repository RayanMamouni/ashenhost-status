# ==============================================================================
# ASHENHOST STATUS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Next.js / Web Application
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super-secret-key-change-this-in-production-min-32-chars

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://ashenhost:ashenhost_secret_pass@localhost:5432/ashenhost_db?schema=public

# Redis (BullMQ Queue & Cache)
REDIS_URL=redis://:redis_secret_pass@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_pass

# Docker Compose Specific (Database container credentials)
POSTGRES_USER=ashenhost
POSTGRES_PASSWORD=ashenhost_secret_pass
POSTGRES_DB=ashenhost_db

# Email / Notification Settings (SMTP / Resend)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM="AshenHost Alert <alerts@example.com>"

# Optional: Public App URL for Links in Alerts
NEXT_PUBLIC_APP_URL=http://localhost:3000
